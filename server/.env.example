# ─────────────────────────────────────────────
#  RestroSaaS — Server Environment
#  Copy to `.env` and fill in real values.
# ─────────────────────────────────────────────

# App
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
APP_NAME=RestroSaaS

# Public URLs (used for QR codes, CORS, cookies)
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4000
# Comma-separated allow-list for CORS
CORS_ORIGINS=http://localhost:5173

# ── PostgreSQL ──
# NOTE: docker-compose maps the DB container to host port 5433 (to avoid clashing
# with a locally-installed PostgreSQL on 5432). Use 5432 if you run Postgres natively.
DATABASE_URL=postgresql://restro:restro@localhost:5433/restrosaas
DB_HOST=localhost
DB_PORT=5433
DB_NAME=restrosaas
DB_USER=restro
DB_PASSWORD=restro
DB_SSL=false
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000

# ── JWT / Auth ──
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Secret used to sign/encrypt table QR tokens
QR_TOKEN_SECRET=change_me_qr_token_secret_min_32_chars

# ── Cookies ──
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ── Supabase Storage ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=restrosaas

# ── Rate limiting ──
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ── Logging ──
LOG_LEVEL=debug
