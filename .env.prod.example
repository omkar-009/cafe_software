# ─────────────────────────────────────────────
#  Production environment (root).
#  Copy to `.env.prod` and fill with REAL secrets.
#  docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# ─────────────────────────────────────────────

# App
NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1
APP_NAME=RestroSaaS

# Public URLs (your domain)
CLIENT_URL=https://app.yourdomain.com
SERVER_URL=https://app.yourdomain.com
CORS_ORIGINS=https://app.yourdomain.com

# ── PostgreSQL ──
DB_NAME=restrosaas
DB_USER=restro
DB_PASSWORD=CHANGE_ME_strong_db_password
DB_SSL=false

# ── JWT / Auth (generate: openssl rand -base64 48) ──
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
QR_TOKEN_SECRET=CHANGE_ME_qr_secret_min_32_chars

# ── Cookies ──
COOKIE_DOMAIN=yourdomain.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# ── Supabase Storage ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=restrosaas

# ── Rate limiting / logging ──
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
LOG_LEVEL=info
