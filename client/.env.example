# Frontend env.
#
# LOCAL DEV: leave both empty — Vite proxies /api and /socket.io to the backend.
VITE_API_URL=
VITE_SOCKET_URL=

# PRODUCTION (frontend hosted on a DIFFERENT domain than the API):
# point these at your live backend, e.g. the Render URL.
#   VITE_API_URL=https://cafe-software-01gs.onrender.com
#   VITE_SOCKET_URL=https://cafe-software-01gs.onrender.com
#
# If you serve the frontend FROM the backend (SERVE_CLIENT=true, single origin),
# leave both empty.
