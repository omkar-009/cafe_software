{
  "name": "restrosaas",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant Restaurant Management SaaS — QR Ordering, KDS, Waiter, Billing, Analytics",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:rollback": "npm run db:rollback --workspace server",
    "db:seed": "npm run db:seed --workspace server",
    "lint": "npm run lint --workspaces --if-present",
    "start": "npm run start --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
